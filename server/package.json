{
  "name": "profitna-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Profitna — accounting and business finance for Nigerian businesses",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "create-admin": "node src/create-admin.js",
    "smoke": "node test/smoke.js",
    "smoke:admin": "node test/admin-smoke.js",
    "test:billing": "node test/billing.js",
    "test:monnify": "node test/monnify.js",
    "test:trial": "node test/trial.js",
    "test:backup": "node test/backup.js",
    "test:ask": "node test/ask.js",
    "test:offsite": "node test/offsite.js",
    "test:meta": "node test/meta.js",
    "test:invoicing": "node test/invoicing.js",
    "test:pdf": "node test/pdf.js",
    "test:ledger": "node test/ledger.js",
    "test:payments": "node test/payments.js",
    "test:recurring": "node test/recurring.js",
    "test:screens": "node test/screens.js",
    "test:email": "node test/email.js",
    "test:payroll": "node test/payroll.js",
    "test:marketing": "node test/marketing.js"
  },
  "//overrides": [
    "express 4.22.2 still pins qs ~6.15.1 for req.query, and every qs below",
    "6.16.1 carries a parse denial-of-service (GHSA-4mjr-xmp4-gh2g). Express 5",
    "is the only release that moves off it on its own, and that is a breaking",
    "change this product has no other reason to take. body-parser already asks",
    "for ~6.16.0, so the whole tree reads one patched copy instead of two.",
    "Remove this the day express 4 ships a newer qs."
  ],
  "overrides": {
    "qs": "^6.16.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.64.1"
  }
}
