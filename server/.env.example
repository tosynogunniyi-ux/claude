# --- Core -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Postgres connection string.
DATABASE_URL=postgres://profitna:profitna@localhost:5432/profitna

# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google sign-in -------------------------------------------------------
# From Google Cloud console → APIs & Services → Credentials → OAuth client ID.
# Without this, /auth/google returns 501 and the UI hides the Google buttons.
GOOGLE_CLIENT_ID=

# --- Payments (Paystack) --------------------------------------------------
# Keys from the Paystack dashboard. With both set, signup collects the card
# through Paystack's checkout instead of the app's own form, and the card is
# authorised for real. Without them, cards are recorded for display only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Charged once at signup to authorise a reusable card, in naira.
PAYSTACK_VERIFY_AMOUNT=50
# Plan codes created in the Paystack dashboard, charged per seat.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_ANNUAL=

# --- AI category suggestions ---------------------------------------------
# Anthropic API key, held server-side only. Falls back to the keyword
# matcher when unset, so the feature still works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Bank feeds (Mono) ----------------------------------------------------
# Nigerian account linking. Okra is defunct — do not integrate it.
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
