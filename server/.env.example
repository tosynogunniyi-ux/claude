# --- Core -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Postgres connection string.
DATABASE_URL=postgres://profitna:profitna@localhost:5432/profitna

# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Control Center (platform owner) --------------------------------------
# The owner's console at /admin. There is no default account and no route
# that creates one: until you run
#   npm run create-admin -- --email you@example.com --name "Your Name"
# the console answers 404 to everyone. The variables below are all optional.
#
# Move the console off the obvious path. Cosmetic, not a control.
ADMIN_PATH=/admin
# Comma-separated IPs. When set, the console does not exist for anyone else.
# Leave empty unless you sign in from a fixed address.
ADMIN_IP_ALLOWLIST=
# Set to 'off' only if you truly cannot use an authenticator app. The second
# factor is what stops one stolen password reaching every customer's books.
ADMIN_TOTP=

# --- Invitation links -----------------------------------------------------
# The origin invitation links are built from. Only needed when the browser
# would see a different address from the one the server does — behind a proxy
# that rewrites Host, for example. Otherwise the request is used.
PUBLIC_URL=

# --- Google sign-in -------------------------------------------------------
# From Google Cloud console → APIs & Services → Credentials → OAuth client ID.
# Without this, /auth/google returns 501 and the UI hides the Google buttons.
GOOGLE_CLIENT_ID=

# --- Payments -------------------------------------------------------------
# Two processors are supported and only one is used at a time. Leave this
# unset and whichever has its keys filled in is the one that runs; Monnify
# wins if both are set. Name it explicitly to be certain:
#   PAYMENT_PROVIDER=monnify
#   PAYMENT_PROVIDER=paystack
PAYMENT_PROVIDER=

# --- Payments: Monnify (Moniepoint) ---------------------------------------
# From Settings → API Keys & Webhooks in the Monnify dashboard. The API key
# and contract code reach the browser — they are public by design and cannot
# authorise anything on their own. The secret key never leaves this server.
#
# For renewals to work at all, Card Tokenisation must be enabled on the
# merchant account: ask Monnify support to turn it on. Without it customers
# can still pay, but no card is kept and nothing auto-renews.
# Paste the bare value after the = sign. No quotes, no brackets, no spaces:
#   MONNIFY_API_KEY=MK_PROD_ABC123      not  MONNIFY_API_KEY="MK_PROD_ABC123"
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# sandbox (default) or live. Point MONNIFY_BASE_URL somewhere else only for
# tests — it overrides the choice entirely.
MONNIFY_ENV=sandbox
MONNIFY_BASE_URL=
# Webhook URL to register in the Monnify dashboard:
#   https://your-domain/api/webhooks/monnify

# --- Payments: Paystack ---------------------------------------------------
# Keys from the Paystack dashboard. Signing up never asks for a card; these
# are what let a customer pay at the end of the trial, and what the renewal
# charge runs through. Without them an expired account cannot be activated
# from the app, and the paywall says so rather than offering a dead button.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Plan codes created in the Paystack dashboard, charged per seat.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_ANNUAL=

# --- Automatic billing ----------------------------------------------------
# Renews terms by charging the card the processor kept when the customer paid
# at the paywall. It runs inside the server process and holds an advisory lock
# for each pass, so more than one container never charges twice. It stays idle
# until a payment processor is configured.
BILLING_SCHEDULER=
BILLING_INTERVAL_MINUTES=60
BILLING_BATCH=50

# --- Nightly backups ------------------------------------------------------
# A verified pg_dump on a schedule, taken by the server itself. It asks on
# every tick whether the newest dump has aged out rather than firing at a
# fixed hour, so a container that restarts in the night makes it up rather
# than silently skipping a day.
#
# BACKUP_DIR must be a mounted volume. A dump written into the container's own
# filesystem disappears with the next deploy, which is the same as no backup.
BACKUP_ENABLED=on
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# These stay on the same machine as the database. Copying them somewhere else
# is the half this cannot do for you — see server/README.md.

# --- Profitna AI ----------------------------------------------------------
# One key powers two things: the category suggestions on the transactions
# screen, and Ask Profitna — the question box that answers from the books.
# Held server-side only; it never reaches the browser.
#
# Without it both degrade honestly rather than breaking. Categories fall back
# to the keyword matcher, and Ask Profitna says "Simulated · no model
# connected" and answers the six questions it can work out from the figures
# already on the page.
ANTHROPIC_API_KEY=
# The model behind the category suggestions.
ANTHROPIC_MODEL=claude-opus-5
# The model behind Ask Profitna, and how hard it is allowed to think. This is
# the one place in the product where a wrong number is worse than a slow
# answer, so it is the better model by default.
ASK_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ASK_EFFORT=medium
# A ceiling per set of books per day, counted in the audit log so a restart
# does not reset it. Each question costs money to answer.
ASK_DAILY_LIMIT=200
ASK_TIMEOUT_MS=60000
ASK_MAX_TOKENS=4000

# --- Bank feeds (Mono) ----------------------------------------------------
# Nigerian account linking. Okra is defunct — do not integrate it.
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
