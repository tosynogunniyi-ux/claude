# Copy to .env on the VPS, beside docker-compose.yml. Never commit the real one.

# The domain Caddy issues a certificate for. Apex only — www is redirected to it.
SITE_DOMAIN=profitna.com

# Database password. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs session cookies. Changing it signs everyone out. Generate one:
#   openssl rand -hex 48
JWT_SECRET=

# Where invitation links point. Leave empty unless the app sees a different
# hostname from the one your team does.
PUBLIC_URL=

# --- Control Center --------------------------------------------------------
# The owner's console. It answers 404 until an account is created with
#   docker compose exec app node src/create-admin.js --email you@example.com
# Both of these are optional; see server/README.md.
ADMIN_PATH=/admin
ADMIN_IP_ALLOWLIST=

# --- Automatic billing -----------------------------------------------------
# On by default; idle until a payment processor is configured. Set
# BILLING_SCHEDULER to off to stop it charging anything.
BILLING_SCHEDULER=
BILLING_INTERVAL_MINUTES=60

# --- Payments --------------------------------------------------------------
# Fill in one of the two. Monnify wins if both are set; PAYMENT_PROVIDER
# settles it either way. Monnify needs Card Tokenisation enabled on the
# merchant account before renewals will work, and its webhook registered at
#   https://your-domain/api/webhooks/monnify
PAYMENT_PROVIDER=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_ENV=sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Optional, each off until set (see server/README.md) -------------------
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
