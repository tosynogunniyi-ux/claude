# Copy to .env on the VPS, beside docker-compose.yml. Never commit the real one.

# The domain Caddy issues a certificate for. Apex only — www is redirected to it.
SITE_DOMAIN=profitna.com

# Database password. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs session cookies. Changing it signs everyone out. Generate one:
#   openssl rand -hex 48
JWT_SECRET=

# --- Control Center --------------------------------------------------------
# The owner's console. It answers 404 until an account is created with
#   docker compose exec app node src/create-admin.js --email you@example.com
# Both of these are optional; see server/README.md.
ADMIN_PATH=/admin
ADMIN_IP_ALLOWLIST=

# --- Optional, each off until set (see server/README.md) -------------------
GOOGLE_CLIENT_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
